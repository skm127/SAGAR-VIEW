DEBUG=false
DATA_DIR=../data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://your-production-domain.example

# AI Guide (SAGAR AI) — Gemini API key. Leave empty to use built-in fallback mode.
GEMINI_API_KEY=

# Copernicus Marine Service (CMEMS) — optional. Free registration at https://data.marine.copernicus.eu/register
# If empty, the live model comes from HYCOM ESPC-D-V02 (US Navy, no login required).
# Never commit real credentials — keep them only in your untracked backend/.env
COPERNICUS_USERNAME=ksarkar
COPERNICUS_PASSWORD=Khushi120706@

# Argo GDAC ERDDAP endpoint (no auth needed)
ARGO_ERDDAP_URL=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats

# Optional Redis Cache (fallback to high-performance in-memory TTL cache)
REDIS_URL=redis://localhost:6379/0

# Data refresh interval in hours (how often to re-download CMEMS data)
DATA_REFRESH_INTERVAL_HOURS=6

# Refresh live data at startup when missing, synthetic or older than N hours (0 disables; tests use 0)
STARTUP_REFRESH_MAX_AGE_HOURS=12
# Days of Argo profiles and model analysis/forecast to ingest
ARGO_DAYS_BACK=21
MODEL_DAYS_BACK=4
MODEL_DAYS_FORWARD=2
# Optional: require header X-Admin-Token for /api/admin/* endpoints
ADMIN_TOKEN=
