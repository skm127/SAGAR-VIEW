# OCEAN-X Environment Variables

# Database
POSTGRES_USER=oceanx
POSTGRES_PASSWORD=oceanx_dev
POSTGRES_DB=oceanx
DATABASE_URL=postgresql://oceanx:oceanx_dev@db:5432/oceanx

# Redis
REDIS_URL=redis://redis:6379/0

# Data directory (relative to backend)
DATA_DIR=/app/data

# Copernicus Marine credentials (optional). Leave empty to use HYCOM ESPC-D-V02 (no login).
# Never commit real credentials — put them in an untracked .env file.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Argo GDAC ERDDAP endpoint
ARGO_ERDDAP_URL=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats

# Live data refresh: refresh at startup if data is missing, synthetic or older than N hours (0 = off)
STARTUP_REFRESH_MAX_AGE_HOURS=12
# Protect /api/admin/* (refresh, reload) with a header X-Admin-Token when set
ADMIN_TOKEN=

# API
VITE_API_URL=http://localhost:8000
